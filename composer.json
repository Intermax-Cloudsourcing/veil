{
  "name": "intermax/veil",
  "type": "library",
  "description": "Improve working with encrypted environment files in Laravel.",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "laravel/framework": "^11.0|^12.0|^13.0",
    "pestphp/pest": "^3.0|^4.0",
    "laravel/pint": "^1.13",
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "larastan/larastan": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Intermax\\Veil\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Intermax\\Veil\\Tests\\": "tests/"
    }
  },
  "suggest": {
    "laravel/framework": "This package is meant to be used with Laravel or Laravel Zero as it extends the commands to encrypt/decrypt environments",
    "laravel-zero/framework": "This package is meant to be used with Laravel or Laravel Zero as it extends the commands to encrypt/decrypt environments"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Intermax\\Veil\\Providers\\VeilServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "lint": "vendor/bin/pint -v --test --ansi",
    "fix": "vendor/bin/pint -v --ansi",
    "analyse": "vendor/bin/phpstan analyse --memory-limit=-1 --ansi",
    "test": "vendor/bin/pest --colors=always",
    "ci": [
      "@fix",
      "@analyse",
      "@test"
    ]
  }
}
